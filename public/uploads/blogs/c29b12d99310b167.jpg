<style id="wp-custom-css">
.counter-box-new .counter-box {
    height: 140px !important;
    width: 140px !important;
    text-align: center;
    padding: 40px 10px;
    margin: 0 auto;
    background-color: #fff;
    box-shadow: 3px 3px 5px rgba(0, 0, 0, .5);
    position: relative;
    transition: .3s;
}
.counter-box-new .counter-box:hover:after {
    transform: translateX(-50%) translateY(-50%) rotate(-90deg);
}

.counter-box-new .counter-box:hover:before {
    transform: translateX(-50%) translateY(-50%) rotate(180deg);
    box-shadow: 0 0 20px -5px rgba(0, 0, 0, .9);
}
.counter-box-new .counter-box p {
    font-size: 14px;
    font-family: 'Raleway', sans-serif;
    font-weight: 700;
    line-height: 26px;
}
.counter-box-new .counter-box img {
    filter: brightness(3%) sepia(35) saturate(66) hue-rotate(299deg);
    width: 40px;
}
.counter-box-new .counter-box:after, .counter-box-new .counter-box:before {
    content: '';
    height: 170px;
    width: 170px;
    border: 6px solid #0bb7bc;
    border-left: none;
    border-right: none;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translateX(-50%) translateY(-50%) rotate(5deg);
    transition: .3s;
}
.counter-box-new .counter-box:after {
    border: 10px solid #0bb7bc;
    border-left: 10px solid transparent;
    border-right: 10px solid transparent;
    transform: translateX(-50%) translateY(-50%) rotate(90deg);
}
