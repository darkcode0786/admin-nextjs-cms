/* IVF Section Container */
.ivf-section {
  max-width: 1000px;
  font-family: "Rethink Sans", Sans-serif;
  margin: 0 auto;
  padding: 20px;
}

/* Wrapper for horizontal scroll */
.ivf-table-wrapper {
  display: block;               /* enables scrolling */
  overflow-x: auto;             /* horizontal scroll */
  -webkit-overflow-scrolling: touch; /* smooth scrolling on iOS */
  width: 100%;
  border-radius: 12px;          /* rounded corners for wrapper */
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

/* Table Styling */
.ivf-table {
  width: 100%;
  min-width: 700px;             /* ensures scroll on small screens */
  border-collapse: collapse;
  background: #fff;
}

/* Table Head */
.ivf-table thead {
  background: #073353;
  color: #fff;
}

.ivf-table th,
.ivf-table td {
  padding: 12px;
  text-align: left;
  white-space: nowrap;          /* prevents text wrapping */
}

.ivf-table th {
  font-size: 16px;
}

/* Table Body Rows */
.ivf-table tbody tr {
  background: #fff;
  border-bottom: 1px solid #eee;
  transition: 0.3s;
}

.ivf-table tbody tr:hover {
  background: #fff5ef;
}

.ivf-table td {
  font-size: 14px;
  color: #333;
}

/* Optional: Scrollbar Styling */
.ivf-table-wrapper::-webkit-scrollbar {
  height: 8px;
}

.ivf-table-wrapper::-webkit-scrollbar-thumb {
  background: #fff;
  border-radius: 10px;
}

/* cost table */

/* SECTION */
.ivf-cost-section {
  width: 100%;
  margin: 30px 0;
  font-family: "Rethink Sans", sans-serif;
}

/* WRAPPER (handles scroll) */
.ivf-cost-wrapper {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

/* TABLE */
.ivf-cost-table {
  width: 700px; /* fixed width for scroll */
  margin: 0 auto;
  border-collapse: collapse;
  background: #ffffff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 10px 25px rgba(0,0,0,0.15);
}

/* HEADER */
.ivf-cost-table thead {
  background: #0f3b57;
  color: #fdbf5a;
}

.ivf-cost-table th {
  padding: 16px;
  font-size: 16px;
  text-align: left;
  white-space: nowrap; /* keep header in one line */
}

/* CELLS */
.ivf-cost-table td {
  padding: 14px 16px;
  border-bottom: 1px solid #eee;
  font-size: 15px;
  color: #333;
  white-space: nowrap; /* prevents breaking */
}

/* ROW HOVER */
.ivf-cost-table tbody tr:hover {
  background: #f4f8fb;
}

/* TOTAL ROW */
.ivf-cost-table tfoot td {
  font-weight: bold;
  background: #0f3b57;
  color: #fdbf5a;
  border-top: 2px solid #fdbf5a;
}

/* SCROLLBAR */
.ivf-cost-wrapper::-webkit-scrollbar {
  height: 6px;
}

.ivf-cost-wrapper::-webkit-scrollbar-thumb {
  background: #0f3b57;
  border-radius: 10px;
}

/* 📱 MOBILE */
@media (max-width: 768px) {

  .ivf-cost-wrapper {
    padding-bottom: 5px; /* space for scrollbar */
  }

  .ivf-cost-table {
    min-width: 650px; /* ensures scroll instead of squeeze */
  }
}

/* tab acc */

/* MAIN SECTION (CENTER FIX) */
.ivf-section {
  max-width: 1100px;   /* controls overall width */
  margin: 0 auto;      /* centers section */
  padding: 20px;
  display: flex;
  gap: 30px;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.ivf-section {
  display: flex;
  gap: 40px;
  align-items: flex-start; /* ✅ stop equal height */
}

.ivf-image {
  flex: 0 0 40%; /* fixed width column */
}

.ivf-image img {
  width: 100%;
  height: auto; /* ✅ natural image height */
  object-fit: cover;
  border-radius: 16px;
}

/* RIGHT FAQ */
.ivf-faq {
  flex: 1;
  min-width: 320px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

/* CARD STYLE */
.ivf-item {
  background: #f3f5f7;
  border-radius: 14px;
  padding: 18px 22px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.ivf-item:hover {
  background: #e8edf2;
  transform: translateY(-2px); /* subtle lift */
}

/* TITLE */
.ivf-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 600;
  color: #123b56;
  font-size: 17px;
}

/* ICON */
.ivf-icon {
  min-width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #0f3b57;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  transition: all 0.3s ease;
}

/* CONTENT */
.ivf-content {
  max-height: 0;
  overflow: hidden;
  transition: all 0.35s ease;
  color: #444;
  font-size: 15px;
  margin-top: 10px;
  line-height: 1.6;
}

/* ACTIVE */
.ivf-item.active {
  background: #eef4f8;
}

.ivf-item.active .ivf-content {
  max-height: 300px;
}

.ivf-item.active .ivf-icon {
  transform: rotate(0deg);
}

/* TABLET */
@media (max-width: 1024px) {
  .ivf-section {
    max-width: 900px;
  }
}

/* MOBILE */
@media (max-width: 768px) {
  .ivf-section {
    flex-direction: column;
    text-align: left;
    padding: 15px;
  }

  .ivf-image img {
    height: auto;
  }

  .ivf-title {
    font-size: 16px;
  }

  .ivf-content {
    font-size: 14px;
  }

  .ivf-icon {
    min-width: 30px;
    height: 30px;
    font-size: 16px;
  }
}

